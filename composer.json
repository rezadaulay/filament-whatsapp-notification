{
    "name": "rezadaulay/filament-whatsapp-notification",
    "description": "Filament WhatsApp notification plugin using an external expressjs-baileys HTTP gateway.",
    "keywords": [
        "rezadaulay",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "whatsapp",
        "baileys",
        "notification",
        "expressjs-baileys"
    ],
    "homepage": "https://github.com/rezadaulay/filament-whatsapp-notification",
    "support": {
        "issues": "https://github.com/rezadaulay/filament-whatsapp-notification/issues",
        "source": "https://github.com/rezadaulay/filament-whatsapp-notification"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Reza Daulay",
            "email": "daulayreza@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Rezadaulay\\FilamentWhatsappNotification\\": "src/",
            "Rezadaulay\\FilamentWhatsappNotification\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rezadaulay\\FilamentWhatsappNotification\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rezadaulay\\FilamentWhatsappNotification\\FilamentWhatsappNotificationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
